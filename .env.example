# Data source: auto (Monday.com MCP, falling back to the Excel snapshots in Data/),
# monday (MCP only) or excel (snapshots only, no Monday.com account needed)
DATA_SOURCE=auto
# Seconds to reuse Monday.com reads before refetching (0 disables)
DATA_CACHE_SECONDS=120

# Monday.com Configuration
MONDAY_API_TOKEN=your_monday_api_token_here
DEALS_BOARD_ID=your_deals_board_id_here
WORK_ORDERS_BOARD_ID=your_work_orders_board_id_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
